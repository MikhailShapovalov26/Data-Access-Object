<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="Who">
        <createTable tableName="customers">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="age" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="Who">
        <createTable tableName="orders">
            <column name="id" type="serial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="date" type="date" defaultValueComputed="CURRENT_DATE">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="int">
                <constraints nullable="false" foreignKeyName="fk_orders_customer"
                             referencedTableName="customers" referencedColumnNames="id"/>
            </column>
            <column name="product_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="numeric">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="Who">
        <insert tableName="customers">
            <column name="name" value="Ivan"/>
            <column name="surname" value="Testcustomers"/>
            <column name="age" value="12"/>
            <column name="phone" value="89214445699"/>
        </insert>
    </changeSet>

    <changeSet id="4" author="Who">
        <insert tableName="orders">
            <column name="customer_id" value="1"/>
            <column name="product_name" value="tea"/>
            <column name="amount" value="1000"/>
            <column name="date" valueComputed="CURRENT_DATE"/>
        </insert>
    </changeSet>

</databaseChangeLog>